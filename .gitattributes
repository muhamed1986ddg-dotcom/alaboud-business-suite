* text=auto

# Linux and Cloud Run source/build files must remain LF on every workstation.
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gcloudignore text eol=lf
.gitignore text eol=lf
.npmrc text eol=lf
gradlew text eol=lf

# Windows launchers keep their native line endings.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never pass through text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.zip binary
