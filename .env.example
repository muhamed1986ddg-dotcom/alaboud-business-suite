NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@localhost:5432/alaboud
DATA_DIR=./data
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000

# رابط الواجهة/الخادم المستخدم في روابط البريد (رابط إعادة تعيين كلمة المرور)
APP_URL=http://localhost:5000

# البريد الإلكتروني (اختياري — تُستخدم في "نسيت كلمة المرور").
# إن تُركت SMTP_HOST فارغة، تُطبع رسائل البريد في السجلات فقط (وضع تطوير).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com
