# Safe example only. Never commit real credentials.
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Production requires PostgreSQL and a JWT secret of at least 32 characters.
DATABASE_URL=postgresql://user:password@localhost:5432/alaboud
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Used only when the very first administrator must be created.
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-temporary-admin-password

# Keep public signup disabled for a private company deployment.
PUBLIC_COMPANY_REGISTRATION_ENABLED=false

# Twelve-hour idle timeout. The signed token can live longer, but an idle
# server-side session is rejected after this window.
SESSION_IDLE_MINUTES=720

# Optional mail delivery for password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PostgreSQL transition flags. Keep the current production behavior until the
# relational mirror has been validated and deliberately enabled.
RELATIONAL_MIRROR_ENABLED=false
POSTGRES_NATIVE_READS=false
NATIVE_INTERACTIVE_READS=false
