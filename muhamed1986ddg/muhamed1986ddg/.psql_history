\q
SELECT state_key, updated_at FROM app_state;
SELECT length(payload::text)FROM app_stateWHERE state_key = 'main';
SELECT length(payload::text)FROM app_stateWHERE state_key = 'main';
gcloud projects get-iam-policy alaboud-business-suite \  --flatten="bindings[].members" \  --filter="bindings.members:serviceAccount:alaboud-sheets@alaboud-business-suite.iam.gserviceaccount.com" \  --format="table(bindings.role)"
gcloud projects get-iam-policy alaboud-business-suite \  --flatten="bindings[].members" \  --filter="bindings.members:serviceAccount:alaboud-sheets@alaboud-business-suite.iam.gserviceaccount.com" \  --format="table(bindings.role)"
gcloud projects add-iam-policy-binding alaboud-business-suite \  --member="serviceAccount:alaboud-sheets@alaboud-business-suite.iam.gserviceaccount.com" \  --role="roles/cloudsql.client"
gcloud projects add-iam-policy-binding alaboud-business-suite \  --member="serviceAccount:alaboud-sheets@alaboud-business-suite.iam.gserviceaccount.com" \  --role="roles/cloudsql.client"
\q
SHOW idle_in_transaction_session_timeout;
SELECT rolname, rolconfigFROM pg_rolesWHERE rolname = 'alaboud_app';
SELECT  datname,  datconfigFROM pg_databaseWHERE datname = 'alaboud_business';
SELECT  d.datname,  s.setconfigFROM pg_database dLEFT JOIN pg_db_role_setting s  ON s.setdatabase = d.oidWHERE d.datname = 'alaboud_business';
\q
\timing on
SELECT length(payload::text)FROM app_stateWHERE state_key = 'main';
\q
SHOW idle_in_transaction_session_timeout;SHOW statement_timeout;
SET idle_in_transaction_session_timeout = '2min';SET statement_timeout = '30s';
ALTER DATABASE alaboud_business SET idle_in_transaction_session_timeout = '2min';ALTER DATABASE alaboud_business SET statement_timeout = '30s';
gcloud run services update alaboud-business-suite-git --region=europe-west1 --no-cpu-throttling
\q
SELECT  pid,  usename,  state,  wait_event_type,  wait_event,  now() - xact_start AS transaction_age,  now() - query_start AS query_age,  LEFT(query, 120) AS queryFROM pg_stat_activityWHERE datname = 'alaboud_business'ORDER BY query_start;
uery_start AS query_age,  LEFT(query, 200) AS queryFROM pg_stat_activityWHERE datname = 'alaboud_business'  AND pid <> pg_backend_pid()  AND state <> 'idle'ORDER BY xact_start NULLS LAST;SELECT  pid,  usename,  state,  wait_event_type,  wait_event,  now() - xact_start AS transaction_age,  now() - query_start AS query_age,  LEFT(query, 200) AS queryFROM pg_stat_activityWHERE datname = 'alaboud_business'  AND pid <> pg_backend_pid()  AND state <> 'idle'ORDER BY xact_start NULLS LAST;
\pset pager off
SELECT usename, state, COUNT(*) AS connectionsFROM pg_stat_activityWHERE datname = 'alaboud_business'GROUP BY usename, stateORDER BY connections DESC;
SHOW max_connections;
\q
